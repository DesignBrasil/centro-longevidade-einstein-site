<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0"
  targetNamespace="http://einstein.br/longevidade/aceleracao">
  <collaboration id="collab_aceleracao">
    <participant id="pool_aceleracao" name="Aceleracao (Frontier) — Jornada do Cliente" processRef="proc_aceleracao"/>
  </collaboration>
  <process id="proc_aceleracao" name="Jornada — Aceleracao" isExecutable="false">
    <laneSet id="ls_aceleracao">
    <lane id="lane_com" name="Comercial / Financeiro">
      <flowNodeRef>s_start</flowNodeRef>
      <flowNodeRef>com0</flowNodeRef>
      <flowNodeRef>com3b</flowNodeRef>
      <flowNodeRef>com4</flowNodeRef>
      <flowNodeRef>com6</flowNodeRef>
      <flowNodeRef>com3a</flowNodeRef>
      <flowNodeRef>s_end</flowNodeRef>
    </lane>
    <lane id="lane_gua" name="Guardiao da Jornada">
      <flowNodeRef>gua0</flowNodeRef>
      <flowNodeRef>gua1</flowNodeRef>
      <flowNodeRef>gua4</flowNodeRef>
      <flowNodeRef>gua6</flowNodeRef>
    </lane>
    <lane id="lane_ast" name="Assistencial">
      <flowNodeRef>ast6</flowNodeRef>
      <flowNodeRef>ast2</flowNodeRef>
      <flowNodeRef>ast5</flowNodeRef>
    </lane>
    </laneSet>
    <startEvent id="s_start" name="Entrada"><outgoing>sf_0</outgoing></startEvent>
    <endEvent id="s_end" name="Fim"><incoming>sf_13</incoming></endEvent>
    <task id="com0" name="Registro
do lead">
      <documentation>Cadastro comercial inicial do interessado.</documentation>
      <incoming>sf_0</incoming><outgoing>sf_1</outgoing>
    </task>
    <task id="gua0" name="Acolhimento
e triagem">
      <documentation>Enfermeiro navegador recebe e faz a triagem inicial de necessidade — autoridade legal de triagem (COFEN 661/2021).</documentation>
      <incoming>sf_1</incoming><outgoing>sf_2</outgoing>
    </task>
    <task id="gua1" name="Recomendacao
de nivel">
      <documentation>Guardiao da jornada recomenda Prevencao, Aceleracao ou Sob Medida com base na triagem.</documentation>
      <incoming>sf_2</incoming><outgoing>sf_3</outgoing>
    </task>
    <task id="com3b" name="⚠️ Validar
enquadramento ANS">
      <documentation>[CRITICO] Calcanhar de Aquiles do projeto: responsavel de compliance ainda nao nomeado. Chamamento Publico ANS no 004/2026 em curso, sem desfecho ate 29/09/2026.</documentation>
      <incoming>sf_4</incoming><outgoing>sf_5</outgoing>
    </task>
    <task id="com4" name="Emitir contrato
/ assinatura">
      <documentation>Formalizacao e ativacao do plano de cuidado.</documentation>
      <incoming>sf_5</incoming><outgoing>sf_6</outgoing>
    </task>
    <task id="gua4" name="Onboarding
pos-assinatura">
      <documentation>Guardiao da jornada inicia a cadencia de contato.</documentation>
      <incoming>sf_6</incoming><outgoing>sf_7</outgoing><outgoing>sf_8</outgoing>
    </task>
    <task id="ast6" name="Reavaliacao
periodica">
      <documentation>3 / 6 / 12 meses, conforme a jornada hibrida presencial + digital.</documentation>
      <incoming>sf_9</incoming><incoming>sf_10</incoming><outgoing>sf_11</outgoing>
    </task>
    <task id="com6" name="Faturamento
recorrente">
      <documentation>Cobranca recorrente do plano de cuidado.</documentation>
      <incoming>sf_11</incoming><outgoing>sf_13</outgoing>
    </task>
    <task id="ast2" name="Protocolos de
investigacao avancada">
      <documentation>Biomarcadores avancados e metas de performance mensuraveis.</documentation>
      <incoming>sf_3</incoming><outgoing>sf_12</outgoing>
    </task>
    <task id="com3a" name="⚠ Pacote misto
reembolsavel+particular">
      <documentation>[GAP] Composicao item a item — parte cai na Lei 14.454, parte e particular. GAP #1 ainda sem desenho fechado.</documentation>
      <incoming>sf_12</incoming><outgoing>sf_4</outgoing>
    </task>
    <task id="ast5" name="Execucao do
protocolo Aceleracao">
      <documentation>Reavaliacoes mais frequentes de biomarcadores.</documentation>
      <incoming>sf_7</incoming><outgoing>sf_9</outgoing>
    </task>
    <task id="gua6" name="Cadencia de
contato ativo">
      <documentation>Contato ativo mais frequente, dado o volume de dados de performance.</documentation>
      <incoming>sf_8</incoming><outgoing>sf_10</outgoing>
    </task>
    <sequenceFlow id="sf_0" sourceRef="s_start" targetRef="com0"/>
    <sequenceFlow id="sf_1" sourceRef="com0" targetRef="gua0"/>
    <sequenceFlow id="sf_2" sourceRef="gua0" targetRef="gua1"/>
    <sequenceFlow id="sf_3" sourceRef="gua1" targetRef="ast2"/>
    <sequenceFlow id="sf_4" sourceRef="com3a" targetRef="com3b"/>
    <sequenceFlow id="sf_5" sourceRef="com3b" targetRef="com4"/>
    <sequenceFlow id="sf_6" sourceRef="com4" targetRef="gua4"/>
    <sequenceFlow id="sf_7" sourceRef="gua4" targetRef="ast5"/>
    <sequenceFlow id="sf_8" sourceRef="gua4" targetRef="gua6"/>
    <sequenceFlow id="sf_9" sourceRef="ast5" targetRef="ast6"/>
    <sequenceFlow id="sf_10" sourceRef="gua6" targetRef="ast6"/>
    <sequenceFlow id="sf_11" sourceRef="ast6" targetRef="com6"/>
    <sequenceFlow id="sf_12" sourceRef="ast2" targetRef="com3a"/>
    <sequenceFlow id="sf_13" sourceRef="com6" targetRef="s_end"/>
  </process>
  <bpmndi:BPMNDiagram id="dia_aceleracao">
    <bpmndi:BPMNPlane id="plane_aceleracao" bpmnElement="collab_aceleracao">
      <bpmndi:BPMNShape id="dishape_pool_aceleracao" bpmnElement="pool_aceleracao" isHorizontal="true">
        <omgdc:Bounds x="0" y="0" width="2140" height="480"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dilane_com" bpmnElement="lane_com" isHorizontal="true">
        <omgdc:Bounds x="30" y="30" width="2110" height="150"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dilane_gua" bpmnElement="lane_gua" isHorizontal="true">
        <omgdc:Bounds x="30" y="180" width="2110" height="150"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dilane_ast" bpmnElement="lane_ast" isHorizontal="true">
        <omgdc:Bounds x="30" y="330" width="2110" height="150"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dishape_s_start" bpmnElement="s_start" color:background-color="#FFFFFF" color:border-color="#0F7A64">
        <omgdc:Bounds x="134" y="87" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dishape_s_end" bpmnElement="s_end" color:background-color="#FFFFFF" color:border-color="#0C3A6F">
        <omgdc:Bounds x="1910" y="87" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dishape_com0" bpmnElement="com0" color:background-color="#DFECFB" color:border-color="#1C7CF9">
        <omgdc:Bounds x="230" y="72" width="150" height="66"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dishape_gua0" bpmnElement="gua0" color:background-color="#E3E9F2" color:border-color="#0C3A6F">
        <omgdc:Bounds x="230" y="222" width="150" height="66"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dishape_gua1" bpmnElement="gua1" color:background-color="#E3E9F2" color:border-color="#0C3A6F">
        <omgdc:Bounds x="440" y="222" width="150" height="66"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dishape_com3b" bpmnElement="com3b" color:background-color="#F7E4CC" color:border-color="#9C5518">
        <omgdc:Bounds x="1070" y="72" width="150" height="66"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dishape_com4" bpmnElement="com4" color:background-color="#DFECFB" color:border-color="#1C7CF9">
        <omgdc:Bounds x="1280" y="72" width="150" height="66"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dishape_gua4" bpmnElement="gua4" color:background-color="#E3E9F2" color:border-color="#0C3A6F">
        <omgdc:Bounds x="1280" y="222" width="150" height="66"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dishape_ast6" bpmnElement="ast6" color:background-color="#DEF2EC" color:border-color="#0F7A64">
        <omgdc:Bounds x="1700" y="372" width="150" height="66"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dishape_com6" bpmnElement="com6" color:background-color="#DFECFB" color:border-color="#1C7CF9">
        <omgdc:Bounds x="1700" y="72" width="150" height="66"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dishape_ast2" bpmnElement="ast2" color:background-color="#DEF2EC" color:border-color="#0F7A64">
        <omgdc:Bounds x="650" y="372" width="150" height="66"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dishape_com3a" bpmnElement="com3a" color:background-color="#F7E4CC" color:border-color="#9C5518">
        <omgdc:Bounds x="860" y="72" width="150" height="66"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dishape_ast5" bpmnElement="ast5" color:background-color="#DEF2EC" color:border-color="#0F7A64">
        <omgdc:Bounds x="1490" y="372" width="150" height="66"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dishape_gua6" bpmnElement="gua6" color:background-color="#E3E9F2" color:border-color="#0C3A6F">
        <omgdc:Bounds x="1700" y="222" width="150" height="66"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="diedge_sf_0" bpmnElement="sf_0"><omgdi:waypoint x="170.0" y="105.0"/><omgdi:waypoint x="230.0" y="105.0"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="diedge_sf_1" bpmnElement="sf_1"><omgdi:waypoint x="380.0" y="105.0"/><omgdi:waypoint x="305.0" y="105.0"/><omgdi:waypoint x="305.0" y="255.0"/><omgdi:waypoint x="230.0" y="255.0"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="diedge_sf_2" bpmnElement="sf_2"><omgdi:waypoint x="380.0" y="255.0"/><omgdi:waypoint x="440.0" y="255.0"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="diedge_sf_3" bpmnElement="sf_3"><omgdi:waypoint x="590.0" y="255.0"/><omgdi:waypoint x="620.0" y="255.0"/><omgdi:waypoint x="620.0" y="405.0"/><omgdi:waypoint x="650.0" y="405.0"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="diedge_sf_4" bpmnElement="sf_4"><omgdi:waypoint x="1010.0" y="105.0"/><omgdi:waypoint x="1070.0" y="105.0"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="diedge_sf_5" bpmnElement="sf_5"><omgdi:waypoint x="1220.0" y="105.0"/><omgdi:waypoint x="1280.0" y="105.0"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="diedge_sf_6" bpmnElement="sf_6"><omgdi:waypoint x="1430.0" y="105.0"/><omgdi:waypoint x="1355.0" y="105.0"/><omgdi:waypoint x="1355.0" y="255.0"/><omgdi:waypoint x="1280.0" y="255.0"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="diedge_sf_7" bpmnElement="sf_7"><omgdi:waypoint x="1430.0" y="255.0"/><omgdi:waypoint x="1460.0" y="255.0"/><omgdi:waypoint x="1460.0" y="405.0"/><omgdi:waypoint x="1490.0" y="405.0"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="diedge_sf_8" bpmnElement="sf_8"><omgdi:waypoint x="1430.0" y="255.0"/><omgdi:waypoint x="1700.0" y="255.0"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="diedge_sf_9" bpmnElement="sf_9"><omgdi:waypoint x="1640.0" y="405.0"/><omgdi:waypoint x="1700.0" y="405.0"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="diedge_sf_10" bpmnElement="sf_10"><omgdi:waypoint x="1850.0" y="255.0"/><omgdi:waypoint x="1775.0" y="255.0"/><omgdi:waypoint x="1775.0" y="405.0"/><omgdi:waypoint x="1700.0" y="405.0"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="diedge_sf_11" bpmnElement="sf_11"><omgdi:waypoint x="1850.0" y="405.0"/><omgdi:waypoint x="1775.0" y="405.0"/><omgdi:waypoint x="1775.0" y="105.0"/><omgdi:waypoint x="1700.0" y="105.0"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="diedge_sf_12" bpmnElement="sf_12"><omgdi:waypoint x="800.0" y="405.0"/><omgdi:waypoint x="830.0" y="405.0"/><omgdi:waypoint x="830.0" y="105.0"/><omgdi:waypoint x="860.0" y="105.0"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="diedge_sf_13" bpmnElement="sf_13"><omgdi:waypoint x="1850.0" y="105.0"/><omgdi:waypoint x="1910.0" y="105.0"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>